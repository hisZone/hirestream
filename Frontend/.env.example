# API URL for Backend
# Local development (empty uses Vite proxy defined in vite.config.ts):
# VITE_API_URL=
# Production (set to your deployed Render backend URL):
VITE_API_URL=https://your-backend.onrender.com

# Optional: Dedicated storage URL if media assets are served from an alternate host or CDN
# VITE_BACKEND_URL=https://your-backend.onrender.com
